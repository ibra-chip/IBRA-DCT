# AI grounding
OPENAI_API_KEY=replace-with-your-key
OPENAI_MODEL=gpt-4o-mini
OPENAI_VISION_MODEL=gpt-4o-mini
# For a local OpenAI-compatible server, use e.g. http://127.0.0.1:11434/v1
AI_BASE_URL=https://api.openai.com/v1
AI_API_KEY=replace-with-local-provider-key
# Used for devis (budget) PDF field extraction fallback in apps/api and server.js
GEMINI_API_KEY=replace-with-your-key
GEMINI_MODEL=gemini-3.6-flash

# Where uploaded devis/facture PDFs are stored on disk (apps/api and server.js)
IBRA_UPLOAD_DIR=./uploads

# Security
# JWT_SECRET is canonical for the Nest workspace; IBRA_JWT_SECRET remains for legacy Express.
JWT_SECRET=replace-with-a-long-random-secret
IBRA_JWT_SECRET=replace-with-a-long-random-secret
PUBLIC_URL=https://ibra-ba.net
APP_BASE_URL=https://ibra-ba.net
WEB_ORIGIN=http://localhost:3002
API_ORIGIN=http://localhost:3001
DATABASE_URL=postgresql://user:password@host:5432/ibra_ba?schema=public
DIRECT_URL=postgresql://user:password@host:5432/ibra_ba?schema=public
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
BREVO_API_KEY=

# SMS delivery via Twilio (used when email delivery is unavailable)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=
