{
  "name": "ibra-ba",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "start": "node server.js",
    "start:legacy": "node server.js",
    "start:api": "npm run start --workspace @ibra-ba/api",
    "start:web": "npm run start --workspace @ibra-ba/web",
    "dev": "concurrently \"node --watch server.js\" \"npm run dev --workspace @ibra-ba/api\" \"npm run dev --workspace @ibra-ba/web -- --port 3002\"",
    "build": "npm run build --workspace @ibra-ba/api && npm run build --workspace @ibra-ba/web",
    "lint": "npm run lint --workspace @ibra-ba/api && npm run lint --workspace @ibra-ba/web",
    "test": "node --test test/*.test.js",
    "migrate:data": "node scripts/migrate-data-json-to-prisma.js",
    "db:validate": "npx prisma validate --schema prisma/schema.prisma",
    "db:generate": "npx prisma generate --schema prisma/schema.prisma",
    "db:migrate:dev": "npx prisma migrate dev --schema prisma/schema.prisma",
    "db:migrate:deploy": "npx prisma migrate deploy --schema prisma/schema.prisma",
    "smoke:api": "node scripts/smoke-api.mjs"
  },
  "dependencies": {
    "bcryptjs": "^3.0.2",
    "compression": "^1.8.2",
    "cors": "^2.8.5",
    "dotenv": "^17.4.2",
    "express": "^5.1.0",
    "jsonwebtoken": "^9.0.2",
    "multer": "^2.3.0",
    "nodemailer": "^10.0.10",
    "pdf-lib": "^1.17.1",
    "pdf-parse": "^2.4.5",
    "web-push": "^3.6.7"
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  }
}
